    <!-- Health Connect: why SleepTight reads health data -->
    <string name="hc_info_title">SleepTight and your health data</string>
    <string name="hc_info_reads_title">What it reads</string>
    <string name="hc_info_reads_body">Sleep sessions (with sleep stages) and heart rate, and only those written by Garmin Connect. It never writes to Health Connect.</string>
    <string name="hc_info_use_title">What it\'s for</string>
    <string name="hc_info_use_body">Your sleep stages are trimmed to the times you tapped Going to bed and I\'m up, and used for that night\'s sleep score (deep and REM sleep) and stage chart. Heart rate is stored with the night.</string>
    <string name="hc_info_private_title">It stays on your phone</string>
    <string name="hc_info_private_body">SleepTight has no account and no server. Everything it reads is kept on this phone and goes nowhere else. You can remove its access at any time in Health Connect.</string>

